# ============================================================================
# Talk2Database — environment configuration
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# The panel and its metadata database read from this file.
# Data sources (PostgreSQL, MySQL, MariaDB, ...) are NOT configured here — each
# user registers connections to their own databases at runtime via the UI.
# NEVER commit your real `.env` — it is gitignored.
# ============================================================================

# ---------------------------------------------------------------------------
# AI provider  (converts natural language -> a single read-only SELECT)
#   AI_PROVIDER : anthropic | openai
#   AI_MODEL    : e.g. claude-opus-4-8  (Anthropic)  |  gpt-4o (OpenAI)
# Only the database SCHEMA is sent to the provider — no table rows, aside from
# two narrow, configurable exceptions: a small set of distinct column values for
# grounding (SCHEMA_SAMPLE_VALUES, on by default) and an opt-in row sample for
# result summaries (AI_ALLOW_SAMPLE_ROWS, off by default). Both are below.
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=replace-me
AI_MODEL=claude-opus-4-8

# When the generated SQL references tables/columns that do not exist in the
# schema, the model is re-prompted with a correction up to ASK_MAX_RETRIES
# times before giving up. ASK_VERIFY_IDENTIFIERS=false disables the check.
ASK_MAX_RETRIES=2
ASK_VERIFY_IDENTIFIERS=true

# DEV ONLY: log the full prompt (system + schema + question) sent to the AI,
# to help tune the Ask prompt. Leave false in production.
ASK_LOG_PROMPT=false

# How many AI-generated example questions to cache per schema snapshot.
SUGGESTED_QUESTIONS_COUNT=5

# "Explain results" summaries send only column names/types + locally-computed
# aggregates by default (keeping the no-row-data promise). Set the flag below to
# also include a small sample of result rows for richer summaries.
AI_ALLOW_SAMPLE_ROWS=false
AI_SAMPLE_ROWS=5

# Schema cost controls (see docs/architecture.md "Schema caching").
# If the serialized schema exceeds SCHEMA_MAX_TOKENS, only the tables most
# relevant to the question (plus their foreign-key neighbours) are sent.
SCHEMA_MAX_TOKENS=6000
# Default table allowlist (empty = all). A connection can override this in its
# options (e.g. {"tables": ["orders", "customers"]}).
SCHEMA_TABLES=
# Default Postgres schemas/namespaces to introspect (comma-separated). A
# connection can override this in its options (e.g. {"schemas": ["public"]}).
SCHEMA_INCLUDE_SCHEMAS=public

# Column allowed-value discovery. Enum and CHECK-constraint values are always
# read from the catalog (structure only). In addition, when SCHEMA_SAMPLE_VALUES
# is on, plain text columns are probed with a bounded `SELECT DISTINCT` so the AI
# filters on real values (e.g. status = 'successful', not 'paid'). This is the
# only place a small set of *distinct column values* is read and sent to the
# provider — set SCHEMA_SAMPLE_VALUES=false to keep strictly to structure-only.
# Columns with more than SCHEMA_SAMPLE_MAX_VALUES distinct values are treated as
# free-text and left unannotated; SCHEMA_SAMPLE_SCAN_LIMIT caps rows scanned.
SCHEMA_SAMPLE_VALUES=true
SCHEMA_SAMPLE_MAX_VALUES=25
SCHEMA_SAMPLE_SCAN_LIMIT=10000

# ---------------------------------------------------------------------------
# Connection registry
# Fernet key used to encrypt each data source's password at rest. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after connections exist makes their stored passwords undecryptable.
# ---------------------------------------------------------------------------
CONNECTIONS_SECRET_KEY=replace-me-with-a-generated-fernet-key

# ---------------------------------------------------------------------------
# Authentication
# Generate a strong secret, e.g.:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
# Base URL of the panel, used to build invite acceptance links.
APP_BASE_URL=http://localhost:8000
# Extra browser origins allowed to call the API (comma-separated). Leave empty
# when the SPA is served by the panel itself (the default single-container setup).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Query execution guard rails (applied to every AI-generated query)
# QUERY_TIMEOUT_SECONDS is enforced per connection as a best-effort session
# read-only + statement timeout. For strongest safety, point each connection at
# a read-only database user.
# ---------------------------------------------------------------------------
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Admin audit feed — lets admins review every user's questions + generated SQL
# (never row data, which is not stored). Set to false to hide the feed entirely.
# ---------------------------------------------------------------------------
ADMIN_AUDIT_ENABLED=true

# ---------------------------------------------------------------------------
# Panel database (postgres-panel) — stores users, connections, query history,
# and schema snapshots. This is the ONLY database the panel needs to own.
# ---------------------------------------------------------------------------
PANEL_DB_HOST=postgres-panel
PANEL_DB_PORT=5432
PANEL_DB_NAME=panel
PANEL_DB_USER=panel
PANEL_DB_PASSWORD=replace-me-panel

# Tip: for the strongest safety, point each data-source connection at a
# read-only database user, e.g. (run in YOUR database, not here):
#   CREATE USER readonly_user WITH PASSWORD 'PasswordReadOnly123';
# ---------------------------------------------------------------------------
# Build-time package mirrors (BUILD ONLY — not read by the running panel)
#
# `docker compose build` fetches Python packages from PyPI and npm packages
# from the npm registry. Where those are slow, filtered, or blocked, the build
# fails with something like:
#
#   ReadTimeoutError(... host='pypi.org' ... Read timed out. (read timeout=15))
#   ERROR: Could not find a version that satisfies the requirement setuptools>=68
#
# ("from versions: none" means the index could not be reached at all — not that
# the package is missing.) The build already waits 120s per read and retries 10
# times; if the host is blocked rather than slow, point these at a mirror that
# your network can reach. Leave them unset to use the upstream defaults.
# ---------------------------------------------------------------------------
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
